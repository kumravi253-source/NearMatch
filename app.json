{
  "expo": {
    "name": "NearMatch",
    "slug": "NearMatch",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kumravi253.nearmatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kumravi253.nearmatch",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8603A"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "NearMatch needs access to your photos so you can set a profile picture.",
          "cameraPermission": "NearMatch needs access to your camera so you can take a profile picture or verify your age with a selfie.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NearMatch uses your approximate location to show you people nearby. Your exact location is never shared with other users — only a fuzzy distance like \"3-5 km away\".",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#E8603A"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "NearMatch uses this identifier to show relevant ads on the free plan. Premium members do not see ads."
