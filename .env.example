EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google AdMob banner unit IDs from https://apps.admob.com
# Leave unset to serve Google's official test ads (safe for development).
# Also replace the sample androidAppId / iosAppId in app.json before a store build.
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-xxxxxxxx/yyyyyyyy
# EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-xxxxxxxx/yyyyyyyy
