{
  // "name" must match the Worker in the Cloudflare dashboard, or Workers
  // Builds rejects the commit before it starts.
  "name": "nearmatch",
  "compatibility_date": "2026-09-09",
  "main": "./workers/security-headers.js",
  "assets": {
    "directory": "./website/",
    "binding": "ASSETS",
    // Worker runs first so origin (Manus/Express) responses also get headers.
    "run_worker_first": true,
    // "none" avoids html_handling 301s to the same URL, which would loop
    // once this Worker wraps ASSETS.fetch. `/` is mapped to index.html.
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  // Attach to the live zone. http→https and www→apex stay at Cloudflare;
  // this only intercepts the apex so security headers actually appear.
  "routes": [
    { "pattern": "nearmatch.in/*", "zone_name": "nearmatch.in" }
  ]
}
