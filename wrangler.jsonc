{
  // "name" must match the Worker name in the Cloudflare dashboard, or the
  // build is rejected before it starts.
  "name": "nearmatch",
  "compatibility_date": "2026-08-29",
  "assets": {
    // Serves the static marketing site. website/_headers is read from this
    // directory, so the /assets/* cache policy applies here as it does on
    // Netlify.
    "directory": "./website/"
  }
  // No "main": with no Worker script, unmatched paths return 404 rather than
  // falling through to code. html_handling and not_found_handling are left at
  // their defaults; the default 404 is correct while website/404.html does not
  // exist.
}
