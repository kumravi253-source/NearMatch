{
  // "name" must match the Worker in the Cloudflare dashboard, or Workers
  // Builds rejects the commit before it starts (zero-second red check).
  "name": "nearmatch",
  "compatibility_date": "2026-08-29",
  "assets": {
    // Serves the static marketing site. website/_headers is read from this
    // directory, so the /assets/* cache policy applies here as it does on
    // Netlify — that is the rule that keeps the 15 MB hero video off every
    // homepage hit.
    "directory": "./website/",
    // Default: /about.html 307s to /about, which still serves about.html.
    // Internal links use the .html suffix and keep working after one hop.
    // "none" is not viable — it would make `/` 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
  // No "main": with no Worker script, unmatched paths return the 404 page
  // rather than falling through to code.
}
